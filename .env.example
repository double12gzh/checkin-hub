# HCNSEC API Credentials (复制本文件为 .env 并填入真实账号密码)
HCNSEC_USERNAME=your_username
HCNSEC_PASSWORD=your_password
# 推荐（免人机极速方案）：在普通浏览器登录后通过 F12 控制台获取 Access Token，彻底免除 Cloudflare Turnstile 人机验证
# HCNSEC_TOKEN=eyJhbGciOi...
# HCNSEC_COOKIE=server_name_session=...

# Columbina New API Credentials
COLUMBINA_USERNAME=your_username
COLUMBINA_PASSWORD=your_password
